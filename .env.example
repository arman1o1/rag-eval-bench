# === LLM & Embeddings ===
OPENAI_API_KEY=sk-...

# Optional: Cohere reranking (falls back to local cross-encoder if unset)
COHERE_API_KEY=

# === Vector Database ===
QDRANT_URL=http://localhost:6333

# === Embedding Model ===
# Options: "openai" (text-embedding-3-large) or "local" (BGE-M3)
EMBEDDING_PROVIDER=openai

# === Generation Model ===
GENERATION_MODEL=gpt-4o

# === Paths ===
CORPUS_DIR=data/corpus
GROUND_TRUTH_DIR=data/ground_truth
RESULTS_DIR=results
